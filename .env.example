# Copy to .env and fill in. Never commit .env.

# ── proxy (VPS fixed egress) ──
WECHAT_PROXY_API_KEY=wpk_change_me_to_a_long_random_string
WECHAT_PEN_APPID=wxYOUR_APPID
WECHAT_PEN_SECRET=YOUR_APPSECRET
WECHAT_PROXY_PORT=8090

# ── pen app ──
WECHAT_PEN_PORT=8080
# Container /dev/shm size for Chromium (Compose: 64m / 1gb / 2gb …). Default Docker ~64MB is too small.
WECHAT_PEN_SHM=1gb
# local = container calls WeChat directly (whitelist container egress IP)
# proxy = open-platform via wechat-proxy (recommended with compose)
WECHAT_PEN_MODE=proxy
WECHAT_PEN_PROXY_URL=http://wechat-proxy:8090
# Headless Chromium for QR login / CDP (leave 1 in Docker)
# WECHAT_PEN_HEADLESS=1
