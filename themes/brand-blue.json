{
  "id": "brand-blue",
  "name": "品牌蓝",
  "description": "示例外部主题：居中大标题 + 蓝色底栏 h2 + 卡片引用",
  "primary": "#2563eb",
  "extends": "simple",
  "base": "margin:0 auto;padding:8px 6px;max-width:680px;font-size:{{fontSize}};color:#0f172a;line-height:{{lineHeight}};letter-spacing:0.02em;word-wrap:break-word;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif;text-align:justify;",
  "tags": {
    "h1": "display:block;font-size:26px;font-weight:800;color:#0f172a;line-height:1.25;margin:1.2em 0 0.6em;text-align:center;letter-spacing:0.04em;",
    "h2": "display:block;font-size:17px;font-weight:800;color:#fff;line-height:1.35;margin:1.4em 0 0.75em;padding:10px 14px;background:{{primary}};border-radius:10px;",
    "h3": "display:block;font-size:16px;font-weight:700;color:#1d4ed8;line-height:1.4;margin:1.2em 0 0.5em;padding-left:10px;border-left:3px solid {{primary}};",
    "p": "display:block;margin:0 0 {{gap}};font-size:{{fontSize}};color:#1e293b;line-height:{{lineHeight}};text-align:{{align}};{{indent}}",
    "blockquote": "display:block;margin:1em 0;padding:14px 16px;color:#1e3a8a;background:#eff6ff;border:none;border-radius:14px;font-size:15px;line-height:1.8;",
    "pre": "display:block;margin:1em 0;padding:14px 16px;background:#0f172a;border-radius:12px;border:1px solid #1e293b;overflow-x:auto;line-height:1.55;font-size:13px;color:#e2e8f0;white-space:pre;",
    "code": "font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;color:#db2777;background:#eff6ff;padding:2px 7px;border-radius:999px;",
    "hr": "display:block;border:none;margin:2em auto;height:4px;width:72px;background:{{primary}};border-radius:999px;",
    "img": "display:block;max-width:100%;height:auto;margin:1.1em auto;border-radius:14px;box-shadow:0 10px 24px rgba(37,99,235,.12);"
  }
}
